# What `gcloud run deploy --source .` uploads to Cloud Build. Secrets never leave this machine.
.gcloudignore
.git
.gitignore
**/.env
**/.env.*
!**/.env.example
**/node_modules/
**/__pycache__/
**/*.pyc
frontend/dist/
frontend/dev-dist/
frontend/test-results/
frontend/playwright-report/
backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/
backend/tests/
backend/scripts/
backend/data/*.db
backend/data/*.db-*
backend/data/*.partial.json
backend/data/external/
.playwright-mcp/
.remember/
.claude/
.vscode/
docs/assets/
docs/samples/
video/
# media that lives in the repo but never ships
*.mp4
*.wav
